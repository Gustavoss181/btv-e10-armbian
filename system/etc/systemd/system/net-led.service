[Unit]
Description=Network status LED (eth0 OR wlan0) - initial state
After=network.target systemd-networkd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Remove o trigger netdev antigo, volta pra controle manual
ExecStartPre=/bin/sh -c 'echo none > /sys/class/leds/btv:status:net/trigger'
# Estado inicial no boot
ExecStart=/usr/local/bin/update-net-led.sh
ExecStop=/bin/sh -c 'echo 0 > /sys/class/leds/btv:status:net/brightness'

[Install]
WantedBy=multi-user.target
